{
  "name": "urlshorten",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Short links, custom aliases, QR codes and destination previews.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "dev:netlify": "npm run build && npx netlify-cli dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "check:publication": "node scripts/check-publication.mjs",
    "release:check": "npm run lint && npm run format && npm run typecheck && npm test && npm run test:e2e && npm run build && npm run check:publication"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "@netlify/functions": "^6.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "globals": "^17.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
